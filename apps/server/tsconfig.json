{
	"extends": "@headcv/config/tsconfig.base.json",
	"include": ["src/**/*.ts", "src/**/*.tsx", "tsdown.config.ts", "vitest.config.ts"],
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmitOnError": false,
		"jsx": "react-jsx",
		"lib": ["ESNext", "DOM"],
		"types": ["node"],
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
