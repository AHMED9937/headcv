# Configure these in Vercel Project Settings, not in a committed .env file.
APP_URL="https://your-project.vercel.app"
# Use the pooled Neon connection string for serverless application traffic.
DATABASE_URL="postgresql://user:password@host-pooler/database?sslmode=require"
# Optional direct (unpooled) URL used by Drizzle Kit and startup migrations.
# Falls back to DATABASE_URL when not set. Set this when DATABASE_URL uses a pooler.
DATABASE_URL_UNPOOLED=""
DATABASE_POOL_MIN="0"
DATABASE_POOL_MAX="10"
AUTH_SECRET="generate-a-cryptographically-random-secret"

# Persistent uploads are required on Vercel because function filesystems are ephemeral.
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_BUCKET=""
S3_FORCE_PATH_STYLE="false"

# Optional authentication and email providers.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
APPLE_APP_BUNDLE_IDENTIFIER=""
SIGNUP_ALLOWED_EMAIL_DOMAINS=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HeadCV <noreply@headcv.com>"
SMTP_SECURE="false"

# Optional AI agent workspace.
REDIS_URL=""
ENCRYPTION_SECRET=""
AI_PROVIDER=""
AI_MODEL=""
AI_BASE_URL=""
AI_API_KEY=""

FLAG_DISABLE_SIGNUPS="false"
FLAG_DISABLE_EMAIL_AUTH="false"
FLAG_ENABLE_PASSKEYS="false"
FLAG_DISABLE_IMAGE_PROCESSING="false"
FLAG_ALLOW_UNSAFE_AI_BASE_URL="false"
FLAG_ALLOW_UNSAFE_OAUTH_REDIRECT_URI="false"

# Billing – Dodo Payments (live). Keys come from the Dodo dashboard in Live mode;
# products are created with packages/api/scripts/dodo-setup-products.mjs.
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
DODO_PAYMENTS_ENVIRONMENT="live_mode"
DODO_PRODUCT_MONTHLY_ID="pdt_0NoO0niz7W9wsqyDaKfjb"
DODO_PRODUCT_YEARLY_ID="pdt_0NoO0nxF1ZBI6KnRg262A"
# Retired "$3 every 7 days" product; keep set only until its subscriptions have ended (scripts/dodo-retire-trials.mjs).
DODO_PRODUCT_TRIAL_ID="pdt_0NoO0o082UJmgmFeyKewm"
# One-time $3 "HeadCV Pro 7-Day Pass" (scripts/dodo-setup-products.mjs). Unset = the trial can't be bought.
DODO_PRODUCT_TRIAL_PASS_ID=""
# Vercel Cron's Bearer token for /api/cron/trial-pass (trial-ended emails). Generate: openssl rand -hex 32
CRON_SECRET=""
