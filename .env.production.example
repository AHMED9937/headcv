# Configure these in Vercel Project Settings, not in a committed .env file.
APP_URL="https://your-project.vercel.app"
# Use the pooled Neon connection string for serverless application traffic.
DATABASE_URL="postgresql://user:password@host-pooler/database?sslmode=require"
# Optional direct (unpooled) URL used by Drizzle Kit and startup migrations.
# Falls back to DATABASE_URL when not set. Set this when DATABASE_URL uses a pooler.
DATABASE_URL_UNPOOLED=""
DATABASE_POOL_MIN="0"
DATABASE_POOL_MAX="10"
AUTH_SECRET="generate-a-cryptographically-random-secret"

# Persistent uploads are required on Vercel because function filesystems are ephemeral.
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_BUCKET=""
S3_FORCE_PATH_STYLE="false"

# Optional authentication and email providers.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HeadCV <noreply@headcv.com>"
SMTP_SECURE="true"

# Optional AI agent workspace.
REDIS_URL=""
ENCRYPTION_SECRET=""
AI_PROVIDER=""
AI_MODEL=""
AI_BASE_URL=""
AI_API_KEY=""

FLAG_DISABLE_SIGNUPS="false"
FLAG_DISABLE_EMAIL_AUTH="false"
FLAG_DISABLE_IMAGE_PROCESSING="false"
FLAG_ALLOW_UNSAFE_AI_BASE_URL="false"
FLAG_ALLOW_UNSAFE_OAUTH_REDIRECT_URI="false"
